{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "react",
    "jsx-a11y",
    "import",
    "unicorn",
    "oxc"
  ],
  "env": {
    "browser": true,
    "node": true
  },
  "rules": {
    "typescript/no-explicit-any": "error",
    "no-unsafe-optional-chaining": "error",
    "eqeqeq": "error"
  }
}

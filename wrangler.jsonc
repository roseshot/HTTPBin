{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "httpbin",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-05",
  "workers_dev": false,
  "preview_urls": false,
  "upload_source_maps": true,
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/get",
      "/post",
      "/put",
      "/patch",
      "/delete",
      "/anything",
      "/anything/*",
      "/ip",
      "/headers",
      "/user-agent",
      "/status/*",
      "/response-headers",
      "/basic-auth/*",
      "/hidden-basic-auth/*",
      "/bearer",
      "/digest-auth/*",
      "/redirect/*",
      "/redirect-to",
      "/relative-redirect/*",
      "/absolute-redirect/*",
      "/cookies",
      "/cookies/*",
      "/uuid",
      "/bytes/*",
      "/stream/*",
      "/stream-bytes/*",
      "/drip",
      "/delay/*",
      "/range/*",
      "/base64/*",
      "/gzip",
      "/deflate",
      "/brotli",
      "/cache",
      "/cache/*",
      "/etag/*",
      "/json",
      "/html",
      "/xml",
      "/encoding/*",
      "/image",
      "/image/*",
      "/links/*",
      "/forms/post",
      "/robots.txt",
      "/deny",
      "/openapi.json",
      "/spec.json",
      "/__meta/*"
    ]
  }
}
